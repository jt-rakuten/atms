<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<GridPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.taskmanager.controller.TaskDialogController"
          hgap="10" vgap="10" padding="20">
    <Label text="Title:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
    <TextField fx:id="titleField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

    <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
    <TextArea fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

    <Label text="Due Date:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
    <DatePicker fx:id="dueDatePicker" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

    <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
    <ComboBox fx:id="statusComboBox" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

    <Label text="Category:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
    <ComboBox fx:id="categoryComboBox" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

    <HBox spacing="10" alignment="CENTER_RIGHT" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="5">
        <Button text="Save" onAction="#handleSave"/>
        <Button text="Cancel" onAction="#handleCancel"/>
    </HBox>
</GridPane>
